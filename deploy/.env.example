# Copy to deploy/.env and fill in. Never commit deploy/.env.
#
# Two profiles — pick one and keep the pair consistent:
#   本机试用 (http://localhost):   FLOW_ENV=dev   FLOW_COOKIE_SECURE=false
#   正式部署 (https behind TLS):   FLOW_ENV=prod  FLOW_COOKIE_SECURE=true
# FLOW_ENV=prod with FLOW_COOKIE_SECURE=false is refused at startup: the api
# container exits and the browser only sees "Bad Gateway".
POSTGRES_PASSWORD=change-me
FLOW_ENV=dev
FLOW_COOKIE_SECURE=false
FLOW_BUSINESS_TIMEZONE=Australia/Sydney
FLOW_BOOTSTRAP_ADMIN_EMAIL=admin@yourcompany.com.au
# >= 10 chars with upper case, lower case and a digit.
FLOW_BOOTSTRAP_ADMIN_PASSWORD=change-me-too
FLOW_LOG_JSON=false
WEB_PORT=8080
